---
// Capacidades reales, no promesas: todas se han usado en proyectos de bimpool.
const capacidades = [
  {
    icon: "M21 21l-4.3-4.3M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14z",
    titulo: "Preguntarle al modelo",
    texto:
      "«¿Cuántas luminarias hay en el Nivel 3?», «¿qué recintos quedaron sin etiqueta?». La respuesta sale del modelo abierto, sin exportar ni filtrar a mano.",
  },
  {
    icon: "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z",
    titulo: "Vistas y plantillas por lote",
    texto:
      "Las dieciséis vistas 3D de la clínica que aparecen en este sitio —plantillas limpias, caja de sección por nivel y exportación— se generaron así.",
  },
  {
    icon: "M4 7h10M4 12h16M4 17h7M18 5v4M20 7h-4",
    titulo: "Etiquetado masivo ordenado",
    texto:
      "Cientos de etiquetas colocadas sin pisarse entre ellas, alineadas por zona y con el líder apuntando a donde corresponde.",
  },
  {
    icon: "M4 6h16M4 12h16M4 18h16M8 3v18",
    titulo: "Tablas y cubicaciones",
    texto:
      "Schedules que leen modelos vinculados, se filtran por lámina y se mantienen al día sin rehacerlos en cada entrega.",
  },
  {
    icon: "M12 3v18M5 8l7-5 7 5M5 16l7 5 7-5",
    titulo: "Edición en lote",
    texto:
      "Mover, renombrar o reparametrizar miles de elementos de una vez. En el aeropuerto: 1.150 puntos llevados a la altura de su propio equipo.",
  },
  {
    icon: "M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6zM9 12l2 2 4-4",
    titulo: "Control de calidad",
    texto:
      "Auditoría de parámetros, elementos sin clasificar y nomenclatura fuera de estándar, revisada en minutos sobre todo el modelo.",
  },
  {
    icon: "M6 3h9l5 5v13H6zM14 3v6h6M12 12v6M9 15l3 3 3-3",
    titulo: "Exportación de entregas",
    texto:
      "Láminas a DWG y PDF con la regla de nombre del proyecto, las revisiones al día y sin la revisión manual archivo por archivo.",
  },
  {
    icon: "M8 9l-4 3 4 3M16 9l4 3-4 3M14 5l-4 14",
    titulo: "De encargo a herramienta",
    texto:
      "Lo que hoy se resuelve conversando, mañana queda como botón de pyRevit en la barra de tu equipo, para que lo use cualquiera.",
  },
];

const pasos = [
  {
    n: "1",
    t: "Tu Revit, tu modelo",
    d: "El conector corre junto a Revit en tu equipo. El archivo del proyecto no se sube a ninguna parte.",
  },
  {
    n: "2",
    t: "Se pide en una frase",
    d: "Claude lee el modelo, revisa qué hay y propone antes de tocar nada.",
  },
  {
    n: "3",
    t: "Se aplica y se puede deshacer",
    d: "Cada cambio entra en una transacción con nombre propio y queda en el historial de Revit, como cualquier edición.",
  },
];
---

<section id="revit-claude" class="rc">
  <div class="container">
    <div class="rc__head">
      <span class="rc__eyebrow">Revit + Claude</span>
      <h2>Lo que antes tomaba una tarde, ahora se pide en una frase</h2>
      <p>
        Conectamos tu Revit con Claude a través de un puente que le permite leer y editar el
        modelo abierto. No es un asistente que da consejos desde afuera: trabaja sobre el
        proyecto, con las mismas reglas que cualquiera del equipo.
      </p>
    </div>

    <ul class="rc__grid">
      {capacidades.map((c) => (
        <li class="rc__item">
          <span class="rc__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d={c.icon} />
            </svg>
          </span>
          <h3>{c.titulo}</h3>
          <p>{c.texto}</p>
        </li>
      ))}
    </ul>

    <div class="rc__como">
      <h4>Cómo funciona</h4>
      <ol>
        {pasos.map((p) => (
          <li>
            <span class="rc__n">{p.n}</span>
            <strong>{p.t}</strong>
            <span class="rc__d">{p.d}</span>
          </li>
        ))}
      </ol>
      <p class="rc__cta">
        <a href="#contacto" class="btn btn--primary">Verlo sobre tu propio modelo</a>
      </p>
    </div>
  </div>
</section>

<style>
  .rc {
    background:
      radial-gradient(900px 500px at 85% 0%, rgba(255, 107, 53, 0.18), transparent 60%),
      linear-gradient(180deg, var(--primary) 0%, var(--primary-2) 100%);
    color: #fff;
    padding-block: clamp(4rem, 8vw, 6.5rem);
  }

  .rc__head { max-width: 680px; margin-bottom: 3rem; }
  .rc__eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .rc__head h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .rc__head > p { margin-top: 1rem; color: #c9cfda; font-size: 1.05rem; }

  .rc__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .rc__item {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .rc__icon {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: rgba(255, 107, 53, 0.16);
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .rc__icon svg { width: 22px; height: 22px; }
  .rc__item h3 { font-size: 1.05rem; margin: 0 0 0.5rem; letter-spacing: -0.01em; }
  .rc__item p { margin: 0; font-size: 0.92rem; color: #a7b0bf; line-height: 1.55; }

  /* ---------- cómo funciona ---------- */
  .rc__como {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .rc__como h4 {
    margin: 0 0 1.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .rc__como ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.75rem;
  }
  .rc__como li { display: grid; gap: 0.35rem; }
  .rc__n {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .rc__como strong { font-size: 0.98rem; font-weight: 600; }
  .rc__d { font-size: 0.9rem; color: #a7b0bf; line-height: 1.55; }

  .rc__cta { margin: 2.5rem 0 0; }

  @media (max-width: 720px) {
    .rc__head { margin-bottom: 2rem; }
    .rc__como { margin-top: 2rem; padding-top: 2rem; }
  }
</style>
