---
const services = [
  {
    icon: "M4 20h16M6 20V9l6-5 6 5v11M10 20v-6h4v6",
    title: "Modelado BIM",
    text: "Arquitectura, estructura e instalaciones en Revit, con el nivel de detalle que exige cada etapa: anteproyecto, licitación o construcción.",
  },
  {
    icon: "M3 12h18M12 3v18M7 7l10 10M17 7 7 17",
    title: "Coordinación y clash detection",
    text: "Cruzamos las especialidades, detectamos interferencias y las resolvemos en reuniones de coordinación con reportes claros y trazables.",
  },
  {
    icon: "M6 3h9l5 5v13H6zM14 3v6h6M9 13h6M9 17h6",
    title: "Documentación y planimetría",
    text: "Plantas, cortes, escantillones, láminas de recinto y tablas de cantidades generadas desde el modelo, listas para revisión y permiso.",
  },
  {
    icon: "M8 9l-4 3 4 3M16 9l4 3-4 3M14 5l-4 14",
    title: "Automatización y scripts",
    text: "Herramientas a medida con pyRevit, Dynamo y la API de Revit: numeración, layouts, exportaciones masivas y control de calidad automático.",
  },
  {
    icon: "M4 6h16M4 12h16M4 18h10",
    title: "BIM Management y BEP",
    text: "Plan de ejecución BIM, estándares de modelado, estructura de worksets y vínculos, y auditoría periódica de los modelos del proyecto.",
  },
  {
    icon: "M12 3 2 8l10 5 10-5-10-5zM6 10v6c0 1.5 3 3 6 3s6-1.5 6-3v-6",
    title: "Capacitación",
    text: "Formación práctica en Revit y flujos BIM para oficinas de arquitectura, ingeniería y constructoras, sobre sus propios proyectos.",
  },
];
---

<section id="servicios" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Servicios</span>
      <h2>Todo lo que un proyecto necesita del modelo, en un solo equipo</h2>
      <p>
        Trabajamos como extensión de tu oficina: entramos en la etapa que necesites y
        entregamos modelos y documentos que el resto del equipo puede usar sin rehacer nada.
      </p>
    </div>
    <div class="grid grid--3">
      {services.map((s) => (
        <article class="card service">
          <span class="service__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d={s.icon} />
            </svg>
          </span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .service { transition: border-color 0.15s ease, transform 0.15s ease; }
  .service:hover { border-color: var(--accent); transform: translateY(-2px); }
  .service__icon {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    margin-bottom: 1.1rem;
  }
  .service__icon svg { width: 24px; height: 24px; }
</style>
