---
const stats = [
  { value: "2012", label: "en BIM desde" },
  { value: "ARQ · STR · MEP", label: "especialidades modeladas" },
  { value: "ISO 19650", label: "estándar · Planbim" },
];

// Retícula isométrica: mismas tres direcciones que el isotipo (vertical, ±30°).
const W = 520, H = 440, CX = 262, CY = 226;
const SP = 40;                       // separación entre verticales
const T30 = Math.tan(Math.PI / 6);   // pendiente de las diagonales
const D = 2 * SP * T30;              // separación de intersecciones en cada vertical
const verticals = Array.from({ length: 15 }, (_, k) => CX + (k - 7) * SP);
const diagonals = Array.from({ length: 21 }, (_, k) => CY + (k - 10) * D);
// nodo de la retícula (i, j): x = CX + i·SP ; y = CY + (j + i/2)·D
const node = (i, j) => ({ x: CX + i * SP, y: CY + (j + i / 2) * D });
const nodes = [
  { i: -4, j: 2 }, { i: -3, j: -1 }, { i: -2, j: 3 }, { i: 2, j: -3 }, { i: 3, j: 1 },
  { i: 4, j: -2 }, { i: -1, j: -3 }, { i: 1, j: 3 }, { i: 5, j: 1 }, { i: -5, j: -1 },
].map((n) => node(n.i, n.j));
const clashes = [node(-3, 0), node(2, 1), node(3, -2)];   // puntos de encuentro destacados
const AX = 112;                                            // largo de los ejes principales
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__eyebrow">Consultoría BIM · Revit · Automatización</span>
      <h1>
        Modelos que <em>sí</em> sirven para construir
      </h1>
      <p>
        Precisión en el modelo, control en la obra. Anticipamos en el modelo los problemas
        que en terreno cuestan tiempo y dinero: modelamos, coordinamos y documentamos para
        arquitectos, ingenieros y constructoras, y automatizamos lo repetitivo para que el
        proyecto avance.
      </p>
      <div class="hero__actions">
        <a href="#contacto" class="btn btn--primary">Cotizar un proyecto</a>
        <a href="#servicios" class="btn btn--ghost">Ver servicios</a>
      </div>
      <ul class="hero__stats">
        {stats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__art" aria-hidden="true">
      <svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="fade" cx="50%" cy="50%" r="60%">
            <stop offset="0" stop-color="#fff" stop-opacity="1" />
            <stop offset="0.7" stop-color="#fff" stop-opacity="0.55" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </radialGradient>
          <mask id="fade-mask"><rect width={W} height={H} fill="url(#fade)" /></mask>
        </defs>

        <!-- Retícula en las tres direcciones del isotipo -->
        <g mask="url(#fade-mask)" stroke="rgba(255,255,255,0.22)" stroke-width="1" fill="none">
          {verticals.map((x) => <line x1={x} y1="0" x2={x} y2={H} />)}
          {diagonals.map((b) => (
            <line x1="0" y1={b - CX * T30} x2={W} y2={b + (W - CX) * T30} />
          ))}
          {diagonals.map((b) => (
            <line x1="0" y1={b + CX * T30} x2={W} y2={b - (W - CX) * T30} />
          ))}
        </g>

        <!-- Nodos de coordinación -->
        <g mask="url(#fade-mask)">
          {nodes.map((n) => <circle cx={n.x} cy={n.y} r="3" fill="rgba(255,255,255,0.55)" />)}
        </g>
        {clashes.map((n) => (
          <g>
            <circle cx={n.x} cy={n.y} r="16" fill="none" stroke="#ff6b35" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.8" />
            <circle cx={n.x} cy={n.y} r="4" fill="#ff6b35" />
          </g>
        ))}

        <!-- Origen: los tres ejes del isotipo -->
        <g stroke="#f7f9fc" stroke-width="3.5" stroke-linecap="round" fill="none">
          <line x1={CX} y1={CY} x2={CX} y2={CY - AX} />
          <line x1={CX} y1={CY} x2={CX - AX * Math.cos(Math.PI / 6)} y2={CY + AX * Math.sin(Math.PI / 6)} />
          <line x1={CX} y1={CY} x2={CX + AX * Math.cos(Math.PI / 6)} y2={CY + AX * Math.sin(Math.PI / 6)} />
        </g>
        <circle cx={CX} cy={CY} r="20" fill="#ff6b35" opacity="0.18" />
        <circle cx={CX} cy={CY} r="8" fill="#ff6b35" />
        <text x={CX + 10} y={CY - AX - 8} fill="#a7b0bf" font-size="11" font-family="DM Sans, system-ui, sans-serif" letter-spacing="0.08em">Z</text>
        <text x={CX - AX * 0.866 - 20} y={CY + AX * 0.5 + 14} fill="#a7b0bf" font-size="11" font-family="DM Sans, system-ui, sans-serif" letter-spacing="0.08em">X</text>
        <text x={CX + AX * 0.866 + 10} y={CY + AX * 0.5 + 14} fill="#a7b0bf" font-size="11" font-family="DM Sans, system-ui, sans-serif" letter-spacing="0.08em">Y</text>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(900px 500px at 85% 10%, rgba(255, 107, 53, 0.28), transparent 60%),
      linear-gradient(180deg, var(--primary) 0%, var(--primary-2) 100%);
    color: #fff;
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .hero__eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  h1 {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }
  h1 em { font-style: normal; color: var(--accent); }
  .hero__copy > p {
    margin-top: 1.5rem;
    font-size: 1.15rem;
    color: #c9cfda;
    max-width: 540px;
  }
  .hero__actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 2.25rem; }
  .hero__stats {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .hero__stats li { display: flex; flex-direction: column; }
  .hero__stats strong { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.02em; white-space: nowrap; }
  .hero__stats span { font-size: 0.85rem; color: #a7b0bf; }
  .hero__art svg { width: 100%; height: auto; }

  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__art { max-width: 420px; margin-inline: auto; }
  }
</style>
