---
const stats = [
  { value: "+120", label: "proyectos coordinados" },
  { value: "−35%", label: "interferencias en obra" },
  { value: "LOD 400", label: "nivel de detalle habitual" },
];
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__eyebrow">Consultoría BIM · Revit · Automatización</span>
      <h1>
        Modelos BIM que resuelven el proyecto <em>antes</em> de llegar a obra
      </h1>
      <p>
        Modelamos, coordinamos y documentamos en Revit para arquitectos, ingenieros y
        constructoras. Menos incompatibilidades, planos confiables y un modelo que sí
        sirve para construir.
      </p>
      <div class="hero__actions">
        <a href="#contacto" class="btn btn--primary">Cotizar un proyecto</a>
        <a href="#servicios" class="btn btn--ghost">Ver servicios</a>
      </div>
      <ul class="hero__stats">
        {stats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__art" aria-hidden="true">
      <svg viewBox="0 0 520 440" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ff6b35" />
            <stop offset="1" stop-color="#d9501f" />
          </linearGradient>
        </defs>
        <g stroke="rgba(255,255,255,0.12)" stroke-width="1">
          {Array.from({ length: 12 }).map((_, i) => (
            <line x1={i * 46} y1="0" x2={i * 46} y2="440" />
          ))}
          {Array.from({ length: 10 }).map((_, i) => (
            <line x1="0" y1={i * 46} x2="520" y2={i * 46} />
          ))}
        </g>
        <!-- Isometric building blocks -->
        <g transform="translate(260 250)">
          <polygon points="0,-120 120,-60 0,0 -120,-60" fill="url(#g1)" />
          <polygon points="-120,-60 0,0 0,140 -120,80" fill="#111c2e" />
          <polygon points="0,0 120,-60 120,80 0,140" fill="#24375a" />
          <g stroke="rgba(255,255,255,0.35)" stroke-width="1.5" fill="none">
            <polyline points="-120,-25 0,35 120,-25" />
            <polyline points="-120,10 0,70 120,10" />
            <polyline points="-120,45 0,105 120,45" />
            <line x1="-60" y1="-30" x2="-60" y2="110" />
            <line x1="60" y1="-30" x2="60" y2="110" />
          </g>
          <polygon points="0,-165 60,-135 0,-105 -60,-135" fill="#f7f9fc" />
          <polygon points="-60,-135 0,-105 0,-75 -60,-105" fill="#a7b0bf" />
          <polygon points="0,-105 60,-135 60,-105 0,-75" fill="#d3d9e2" />
        </g>
        <g fill="none" stroke="#ff6b35" stroke-width="2" stroke-dasharray="6 6">
          <circle cx="110" cy="90" r="30" />
          <circle cx="430" cy="360" r="30" />
        </g>
        <g fill="#ff6b35">
          <circle cx="110" cy="90" r="5" />
          <circle cx="430" cy="360" r="5" />
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(900px 500px at 85% 10%, rgba(255, 107, 53, 0.28), transparent 60%),
      linear-gradient(180deg, var(--primary) 0%, var(--primary-2) 100%);
    color: #fff;
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .hero__eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  h1 {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }
  h1 em { font-style: normal; color: var(--accent); }
  .hero__copy > p {
    margin-top: 1.5rem;
    font-size: 1.15rem;
    color: #c9cfda;
    max-width: 540px;
  }
  .hero__actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 2.25rem; }
  .hero__stats {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .hero__stats li { display: flex; flex-direction: column; }
  .hero__stats strong { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em; }
  .hero__stats span { font-size: 0.85rem; color: #a7b0bf; }
  .hero__art svg { width: 100%; height: auto; }

  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__art { max-width: 420px; margin-inline: auto; }
  }
</style>
