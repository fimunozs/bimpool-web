---
// Reemplaza TU_ID por el id de tu formulario en https://formspree.io (plan gratuito).
// Mientras tanto el formulario cae al mailto: de abajo.
const FORM_ENDPOINT = "https://formspree.io/f/TU_ID";
const useFormspree = !FORM_ENDPOINT.includes("TU_ID");
---

<section id="contacto" class="section">
  <div class="container contact">
    <div class="contact__copy">
      <span class="eyebrow">Contacto</span>
      <h2>Cuéntanos de tu proyecto</h2>
      <p>
        Respondemos en menos de 24 horas hábiles con una propuesta de alcance y plazos.
        Si prefieres, escríbenos directo:
      </p>
      <ul class="contact__channels">
        <li>
          <span>Correo</span>
          <a href="mailto:contacto@bimpool.cl">contacto@bimpool.cl</a>
        </li>
        <li>
          <span>WhatsApp</span>
          <a href="https://wa.me/56900000000" target="_blank" rel="noopener">+56 9 0000 0000</a>
        </li>
        <li>
          <span>Ubicación</span>
          <a>Santiago, Chile · trabajo remoto en todo el país</a>
        </li>
      </ul>
    </div>

    <form
      class="form"
      action={useFormspree ? FORM_ENDPOINT : "mailto:contacto@bimpool.cl"}
      method={useFormspree ? "POST" : "GET"}
      enctype={useFormspree ? undefined : "text/plain"}
    >
      <label>
        Nombre
        <input type="text" name="nombre" required autocomplete="name" />
      </label>
      <label>
        Correo
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>
        Empresa
        <input type="text" name="empresa" autocomplete="organization" />
      </label>
      <label>
        ¿Qué necesitas?
        <select name="servicio">
          <option>Modelado BIM</option>
          <option>Coordinación / clash detection</option>
          <option>Documentación y planimetría</option>
          <option>Automatización</option>
          <option>BIM Management / BEP</option>
          <option>Capacitación</option>
          <option>Otro</option>
        </select>
      </label>
      <label class="form__full">
        Mensaje
        <textarea name="mensaje" rows="5" required placeholder="Tipo de proyecto, superficie, etapa, plazos…"></textarea>
      </label>
      <button type="submit" class="btn btn--primary form__full">Enviar mensaje</button>
    </form>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3.5rem;
    align-items: start;
  }
  .contact h2 { font-size: clamp(1.8rem, 3.2vw, 2.5rem); color: var(--primary); }
  .contact__copy > p { margin-top: 1rem; color: var(--muted); font-size: 1.05rem; }
  .contact__channels { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1.1rem; }
  .contact__channels span { display: block; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .contact__channels a { font-weight: 600; color: var(--primary); }

  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
  }
  .form label { display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.88rem; font-weight: 600; color: var(--primary); }
  .form input, .form select, .form textarea {
    font: inherit;
    font-weight: 400;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
  }
  .form input:focus, .form select:focus, .form textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  .form__full { grid-column: 1 / -1; }
  .form button { justify-content: center; }

  @media (max-width: 860px) {
    .contact { grid-template-columns: 1fr; }
    .form { grid-template-columns: 1fr; padding: 1.5rem; }
  }
</style>
