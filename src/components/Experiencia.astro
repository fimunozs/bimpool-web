---
import { experiencia } from "../data/experiencia.js";

// ¿existe la foto en public/? si no, el bloque se arma igual, solo sin imagen
const fotos = import.meta.glob("/public/experiencia/*.webp", { eager: true });
const hay = (ruta) => Object.keys(fotos).some((k) => k.endsWith(ruta));
---

<div class="exp">
  <div class="exp__head">
    <h4>De dónde viene el equipo</h4>
    <p>
      Antes de bimpool, los mismos modeladores trabajaron dentro de los equipos de IDOM y
      GITC. Los proyectos de abajo <strong>no son encargos de bimpool</strong>: son la
      experiencia de quienes hoy modelan aquí.
    </p>
  </div>

  <div class="exp__grid">
    {experiencia.map((e) => (
      <article class="exp__item">
        <header>
          <img class="exp__logo" src={e.logo} alt={e.empresa} loading="lazy" decoding="async" />
          <div>
            <strong>{e.rol}</strong>
            <span>{e.periodo} · {e.lugar}</span>
          </div>
        </header>

        {e.foto && hay(e.foto) && (
          <figure class="exp__foto">
            <img src={e.foto} alt={e.pie} loading="lazy" decoding="async" />
            <figcaption>{e.pie}</figcaption>
          </figure>
        )}

        <ul>
          {e.proyectos.map((p) => <li>{p}</li>)}
        </ul>
      </article>
    ))}
  </div>
</div>

<style>
  .exp {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--line);
  }
  .exp__head { max-width: 62ch; margin-bottom: 2.25rem; }
  .exp__head h4 {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
    color: var(--primary);
  }
  .exp__head p { color: var(--muted); font-size: 0.95rem; }
  .exp__head strong { color: var(--primary); font-weight: 600; }

  .exp__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .exp__item {
    background: var(--neutral);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .exp__item header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .exp__logo { height: 18px; width: auto; opacity: 0.7; flex: none; }
  .exp__item header strong {
    display: block;
    font-size: 0.92rem;
    color: var(--primary);
  }
  .exp__item header span {
    display: block;
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 0.1rem;
  }

  .exp__foto { margin: 1.25rem 0 0; }
  .exp__foto img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }
  .exp__foto figcaption {
    margin-top: 0.55rem;
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .exp__item ul {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  .exp__item li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .exp__item li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 1px;
    background: var(--secondary);
  }
</style>
