---
// Lista compacta de la experiencia previa del equipo DENTRO de un rubro.
// Projects.astro le pasa ya filtrados los proyectos de la categoría; el aviso de
// que no son encargos de bimpool va una sola vez, en la cabecera de la sección.
// `solo` = el rubro no tiene ningún encargo de bimpool encima, así que la lista
// cuelga directo del título y no necesita separador propio.
const { items, solo = false } = Astro.props;
---

{items.length > 0 && (
  <div class={solo ? "exp exp--solo" : "exp"}>
    <h5>Experiencia previa del equipo</h5>

    <ul class="exp__lista">
      {items.map((p) => (
        <li>
          <span class="exp__thumb">
            {p.foto && <img src={p.foto} alt="" width="40" height="30" loading="lazy" decoding="async" />}
          </span>
          <span class="exp__nombre">{p.nombre}</span>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .exp {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line);
  }
  .exp--solo {
    margin-top: 1.75rem;
    padding-top: 0;
    border-top: 0;
  }
  .exp h5 {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .exp__lista {
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.7rem 1.75rem;
  }
  .exp__lista li {
    display: grid;
    grid-template-columns: 40px 1fr;   /* la columna se reserva siempre: los nombres quedan alineados */
    align-items: center;
    gap: 0.75rem;
  }
  .exp__thumb {
    display: block;
    width: 40px;
    height: 30px;
  }
  .exp__thumb img {
    width: 40px;
    height: 30px;
    object-fit: cover;
    border-radius: 3px;
    display: block;
    filter: saturate(0.75);
    opacity: 0.85;
  }
  .exp__nombre {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.35;
  }
</style>
