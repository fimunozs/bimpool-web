---
import { proyectosPrevios } from "../data/experiencia.js";
---

<div class="exp">
  <h4>De dónde viene el equipo</h4>
  <p>
    Antes de bimpool, los mismos modeladores participaron en estos proyectos dentro del
    equipo de otras oficinas. <strong>No son encargos de bimpool</strong>: son la
    experiencia de quienes hoy modelan aquí.
  </p>

  <ul class="exp__lista">
    {proyectosPrevios.map((p) => (
      <li>
        <span class="exp__thumb">
          {p.foto && <img src={p.foto} alt="" width="40" height="30" loading="lazy" decoding="async" />}
        </span>
        <span class="exp__nombre">{p.nombre}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .exp {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--line);
  }
  .exp h4 {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
    color: var(--primary);
  }
  .exp > p {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 62ch;
  }
  .exp strong { color: var(--primary); font-weight: 600; }

  .exp__lista {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.7rem 1.75rem;
  }
  .exp__lista li {
    display: grid;
    grid-template-columns: 40px 1fr;   /* la columna se reserva siempre: los nombres quedan alineados */
    align-items: center;
    gap: 0.75rem;
  }
  .exp__thumb {
    display: block;
    width: 40px;
    height: 30px;
  }
  .exp__thumb img {
    width: 40px;
    height: 30px;
    object-fit: cover;
    border-radius: 3px;
    display: block;
    filter: saturate(0.75);
    opacity: 0.85;
  }
  .exp__nombre {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.35;
  }
</style>
