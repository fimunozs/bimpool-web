---
import { proyectosPrevios, foto } from "../data/experiencia.js";

// la foto se muestra solo si el archivo existe en public/experiencia/
const fotos = import.meta.glob("/public/experiencia/*.webp", { eager: true });
const hayFoto = Object.keys(fotos).some((k) => k.endsWith(foto.src));
---

<div class:list={["exp", hayFoto && "exp--con-foto"]}>
  <div class="exp__texto">
    <h4>De dónde viene el equipo</h4>
    <p>
      Antes de bimpool, los mismos modeladores participaron en estos proyectos dentro del
      equipo de otras oficinas. <strong>No son encargos de bimpool</strong>: son la
      experiencia de quienes hoy modelan aquí.
    </p>

    <ul class="exp__lista">
      {proyectosPrevios.map((p) => <li>{p}</li>)}
    </ul>
  </div>

  {hayFoto && (
    <figure class="exp__foto">
      <img src={foto.src} alt={foto.pie} loading="lazy" decoding="async" />
      <figcaption>{foto.pie}</figcaption>
    </figure>
  )}
</div>

<style>
  .exp {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--line);
  }
  .exp--con-foto {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2.5rem;
    align-items: start;
  }

  .exp__texto h4 {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
    color: var(--primary);
  }
  .exp__texto > p {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 62ch;
  }
  .exp__texto strong { color: var(--primary); font-weight: 600; }

  .exp__lista {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0.6rem 1.75rem;
  }
  .exp__lista li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .exp__lista li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.58em;
    width: 5px;
    height: 1px;
    background: var(--accent);
  }

  .exp__foto { margin: 0; }
  .exp__foto img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }
  .exp__foto figcaption {
    margin-top: 0.55rem;
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.4;
  }

  @media (max-width: 860px) {
    .exp--con-foto { grid-template-columns: 1fr; gap: 1.75rem; }
    .exp__foto { max-width: 320px; }
  }
</style>
