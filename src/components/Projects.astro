---
import { proyectos } from "../data/proyectos.js";

// lista plana para el visor: cada botón guarda el índice de proyecto y el de vista
const visor = proyectos.map((p) => p.vistas);
---

<section id="proyectos" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Proyectos</span>
      <h2>Lo que entregamos, visto en el modelo</h2>
      <p>
        Trabajo en curso, exportado desde los propios modelos. Podemos compartir más casos y
        el detalle de cada entrega bajo acuerdo de confidencialidad.
      </p>
    </div>

    {proyectos.map((p, pi) => {
      const portada = p.vistas.find((v) => v.codigo === p.portada) ?? p.vistas[0];
      return (
        <div class="proyecto">
          <article class="caso">
            <figure class="caso__portada">
              <button
                class="visor-abrir"
                type="button"
                data-p={pi}
                data-i={p.vistas.indexOf(portada)}
                aria-label={`Ampliar ${portada.nombre}`}
              >
                <img
                  src={portada.src}
                  alt={`${p.titulo} · ${portada.nombre}`}
                  loading="lazy"
                  decoding="async"
                />
              </button>
              <figcaption>{portada.codigo} · {portada.nombre}</figcaption>
            </figure>

            <div class="caso__info">
              <span class="caso__tag">{p.tag}</span>
              <h3>{p.titulo}</h3>

              <div class="cliente">
                <span class="cliente__label">Cliente</span>
                <img
                  class="cliente__logo"
                  src={p.cliente.logo}
                  alt={p.cliente.nombre}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              {p.parrafos.map((t) => <p class="caso__resumen">{t}</p>)}

              <dl class="caso__ficha">
                {p.ficha.map((f) => (
                  <div>
                    <dt>{f.k}</dt>
                    <dd>{f.v}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </article>

          <div class="galeria-head">
            <h4>{p.galeria}</h4>
            <span>Toca una vista para ampliarla</span>
          </div>

          <ul class="galeria">
            {p.vistas.map((v, i) => (
              <li>
                <button
                  class="visor-abrir"
                  type="button"
                  data-p={pi}
                  data-i={i}
                  aria-label={`Ampliar ${v.nombre}`}
                >
                  <img src={v.thumb} alt={v.nombre} loading="lazy" decoding="async" />
                  <span class="galeria__pie">
                    <strong>{v.codigo}</strong>
                    {v.nombre}
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>

  <div class="visor" hidden>
    <button class="visor__cerrar" type="button" aria-label="Cerrar">&times;</button>
    <button class="visor__nav visor__nav--prev" type="button" aria-label="Anterior">&#8249;</button>
    <figure class="visor__marco">
      <img src="" alt="" />
      <figcaption></figcaption>
    </figure>
    <button class="visor__nav visor__nav--next" type="button" aria-label="Siguiente">&#8250;</button>
  </div>
</section>

<script define:vars={{ visor }}>
  const caja = document.querySelector(".visor");
  const img = caja.querySelector("img");
  const pie = caja.querySelector("figcaption");
  let pAct = 0;
  let iAct = 0;

  const mostrar = (p, i) => {
    const lista = visor[p];
    pAct = p;
    iAct = (i + lista.length) % lista.length;
    const v = lista[iAct];
    img.src = v.src;
    img.alt = v.nombre;
    pie.textContent = `${v.codigo} · ${v.nombre}`;
  };

  const abrir = (p, i) => {
    mostrar(p, i);
    caja.hidden = false;
    document.body.style.overflow = "hidden";
    caja.querySelector(".visor__cerrar").focus();
  };

  const cerrar = () => {
    caja.hidden = true;
    document.body.style.overflow = "";
  };

  document.querySelectorAll(".visor-abrir").forEach((b) =>
    b.addEventListener("click", () => abrir(Number(b.dataset.p), Number(b.dataset.i)))
  );
  caja.querySelector(".visor__cerrar").addEventListener("click", cerrar);
  caja.querySelector(".visor__nav--prev").addEventListener("click", () => mostrar(pAct, iAct - 1));
  caja.querySelector(".visor__nav--next").addEventListener("click", () => mostrar(pAct, iAct + 1));
  caja.addEventListener("click", (e) => {
    if (e.target === caja) cerrar();
  });
  document.addEventListener("keydown", (e) => {
    if (caja.hidden) return;
    if (e.key === "Escape") cerrar();
    if (e.key === "ArrowLeft") mostrar(pAct, iAct - 1);
    if (e.key === "ArrowRight") mostrar(pAct, iAct + 1);
  });
</script>

<style>
  .proyecto + .proyecto {
    margin-top: 4.5rem;
    padding-top: 4.5rem;
    border-top: 1px solid var(--line);
  }

  /* ---------- caso destacado ---------- */
  .caso {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2.5rem;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem;
    background: #fff;
  }
  .caso__portada { margin: 0; }
  .caso__portada img { width: 100%; height: auto; border-radius: 8px; background: #fff; }
  .caso__portada figcaption {
    margin-top: 0.75rem;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .caso__tag {
    display: inline-block;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.9rem;
  }
  .caso__info h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    color: var(--primary);
    letter-spacing: -0.015em;
  }

  /* ---------- cuadro de cliente ---------- */
  .cliente {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.1rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--neutral);
    width: fit-content;
  }
  .cliente__label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding-right: 0.85rem;
    border-right: 1px solid var(--line);
  }
  .cliente__logo {
    height: 20px;
    width: auto;
    opacity: 0.75;
  }

  .caso__resumen { margin-top: 1rem; color: var(--muted); font-size: 0.97rem; }
  .caso__ficha {
    margin: 1.75rem 0 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .caso__ficha > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  .caso__ficha dt {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .caso__ficha dd { margin: 0; font-size: 0.92rem; font-weight: 600; color: var(--primary); }

  /* ---------- galería ---------- */
  .galeria-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 3rem 0 1.25rem;
  }
  .galeria-head h4 { margin: 0; font-size: 1.05rem; color: var(--primary); }
  .galeria-head span { font-size: 0.85rem; color: var(--muted); }

  .galeria {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1rem;
  }
  .galeria li { display: flex; }
  .galeria__pie {
    display: block;
    padding: 0.7rem 0.85rem 0.85rem;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.35;
  }
  .galeria__pie strong {
    display: block;
    color: var(--accent-dark);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.15rem;
  }

  .visor-abrir {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    cursor: zoom-in;
    text-align: left;
    font: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .visor-abrir:hover { border-color: var(--accent); transform: translateY(-2px); }
  .visor-abrir:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .galeria .visor-abrir img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    padding: 0.5rem;
    background: #fff;
  }
  .caso__portada .visor-abrir { border: 0; border-radius: 8px; }
  .caso__portada .visor-abrir:hover { transform: none; }

  /* ---------- visor ---------- */
  .visor {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(26, 41, 66, 0.94);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: clamp(1rem, 4vw, 3rem);
  }
  .visor[hidden] { display: none !important; }
  .visor__marco {
    margin: 0;
    max-width: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: center;
  }
  .visor__marco img {
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    background: #fff;
    border-radius: 8px;
    padding: 0.5rem;
  }
  .visor__marco figcaption {
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
  }
  .visor__cerrar,
  .visor__nav {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    line-height: 1;
    flex: none;
  }
  .visor__cerrar { position: absolute; top: 1rem; right: 1rem; width: 44px; height: 44px; font-size: 1.6rem; }
  .visor__nav { width: 48px; height: 48px; font-size: 2rem; }
  .visor__cerrar:hover,
  .visor__nav:hover { background: var(--accent); }

  @media (max-width: 900px) {
    .caso { grid-template-columns: 1fr; padding: 1.25rem; gap: 1.75rem; }
    .caso__ficha > div { grid-template-columns: 7rem 1fr; }
    .visor__nav { width: 40px; height: 40px; font-size: 1.5rem; }
    .proyecto + .proyecto { margin-top: 3rem; padding-top: 3rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .visor-abrir { transition: none; }
    .visor-abrir:hover { transform: none; }
  }
</style>
